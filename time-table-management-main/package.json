{
  "name": "express-starter-template",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "start": "node --enable-source-maps dist/index.js",
    "dev": "npm run build && npm run start",
    "dev:ts": "nodemon src/index.ts",
