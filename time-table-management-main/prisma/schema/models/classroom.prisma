model Classroom {
  id             String             @id @default(uuid())
  name           String
  type           ClassroomType
  description    String?
  location       String
  maxCapacity    Int
  features       ClassroomFeature[] @default([])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  classSchedules ClassSchedule[]
}
